generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int    @id @default(autoincrement())
  username          String    @unique
  email             String    @unique
  password          String
  avatar            String?
  globalRole        GlobalRole  @default(USER)
  memberships       ProjectMembership[]
  createdProjects   Project[]
  RefreshTokens     RefreshToken[]
  assignedTasks     Task[]   @relation("TaskAssignee")
  reportedTasks     Task[]   @relation("TaskReporter")
  comments          Comment[]
  auditLogs         AuditLog[]
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdById Int
  archived    Boolean    @default(false)
  archivedAt  DateTime?
  createdBy   User @relation(fields: [createdById], references: [id])
  members     ProjectMembership[]
  createdAt   DateTime @default(now())
  columns     Column[]
  workflowTransitions WorkflowTransition[]
}

model ProjectMembership {
  id        Int @id @default(autoincrement())
  userId    Int 
  projectId Int 
  role      ProjectRole
  user      User    @relation(fields: [userId], references: [id])
  project   Project @relation(fields: [projectId], references: [id])
   @@unique([userId, projectId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum GlobalRole {
  GLOBAL_ADMIN
  USER
}

enum ProjectRole {
  PROJECT_ADMIN
  PROJECT_MEMBER
  PROJECT_VIEWER
}

model Column {
  id        Int      @id @default(autoincrement())
  title     String
  order     Int      
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]   
  createdAt DateTime @default(now())
  transitionsFrom WorkflowTransition[] @relation("FromTransition")
  transitionsTo   WorkflowTransition[] @relation("ToTransition")
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  columnId    Int
  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  description String?
  order       Int      
  issueType   IssueType @default(TASK)
  priority    Priority  @default(MEDIUM)
  parentId    Int?
  parent      Task?     @relation("StoryChildren", fields: [parentId], references: [id])
  children    Task[]    @relation("StoryChildren")
  assigneeId  Int?     
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId  Int
  reporter    User      @relation("TaskReporter", fields: [reporterId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dueDate     DateTime?
  resolvedAt  DateTime? 
  closedAt    DateTime?
  comments    Comment[]
  auditLogs   AuditLog[]
}

enum IssueType{
  STORY 
  TASK 
  BUG
}

enum Priority{
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActivityType{
  STATUS_CHANGE
  ASSIGNEE_CHANGE
  PRIORITY_CHANGE
  COMMENT_ADDED
  COMMENT_EDITED
  COMMENT_DELETED
  TASK_CREATED
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String  
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        Int          @id @default(autoincrement())
  taskId    Int
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  type      ActivityType
  oldValue  String? 
  newValue  String? 
  createdAt DateTime     @default(now())
}

model WorkflowTransition {
  id             Int     @id @default(autoincrement())
  projectId      Int
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  fromColumnId   Int
  toColumnId     Int 
  
  fromColumn     Column  @relation("FromTransition", fields: [fromColumnId], references: [id], onDelete: Cascade)
  toColumn       Column  @relation("ToTransition", fields: [toColumnId], references: [id], onDelete: Cascade)
  @@unique([projectId, fromColumnId, toColumnId]) 
}