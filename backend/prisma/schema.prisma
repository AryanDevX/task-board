generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//User and Authentication:
model User {
  id              Int                 @id @default(autoincrement())
  username        String              @unique
  email           String              @unique
  password        String
  avatar          String?
  globalRole      GlobalRole          @default(USER)

  //relations
  memberships     ProjectMembership[]
  RefreshTokens   RefreshToken[]
  assignedTasks   Task[]              @relation("TaskAssignee")
  reportedTasks   Task[]              @relation("TaskReporter")
  comments        Comment[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  createdProjects Project[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  //relation:
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//Project and Roles:
model Project {
  id          Int                 @id @default(autoincrement())
  name        String
  description String?
  archived    Boolean             @default(false)
  archivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdById Int

  //relations:
  createdBy   User                @relation(fields: [createdById], references: [id])
  members     ProjectMembership[]
  boards      Board[]
}

model ProjectMembership {
  id        Int         @id @default(autoincrement())
  userId    Int
  projectId Int
  role      ProjectRole

  //relations:
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

//Board, Columns, Workflow:
model Board {
  id                  Int                  @id @default(autoincrement())
  title               String
  projectId           Int

  //relations:
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns             Column[]
  workflowTransitions WorkflowTransition[]
}

model Column {
  id              Int                  @id @default(autoincrement())
  title           String
  order           Int
  wipLimit        Int?
  boardId         Int

  //relations:
  board           Board                @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks           Task[]
  transitionsFrom WorkflowTransition[] @relation("FromTransition")
  transitionsTo   WorkflowTransition[] @relation("ToTransition")
}

model WorkflowTransition {
  id           Int    @id @default(autoincrement())
  boardId      Int
  fromColumnId Int
  toColumnId   Int

  //relations:
  board        Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  fromColumn   Column @relation("FromTransition", fields: [fromColumnId], references: [id], onDelete: Cascade)
  toColumn     Column @relation("ToTransition", fields: [toColumnId], references: [id], onDelete: Cascade)

  @@unique([boardId, fromColumnId, toColumnId])
}

// TASKS & COLLABORATION
model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  order       Float // Changed to Float for fractional indexing
  issueType   IssueType @default(TASK)
  priority    Priority  @default(MEDIUM)
  columnId Int
  parentId Int?
  assigneeId Int?
  reporterId Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  dueDate    DateTime?
  resolvedAt DateTime?
  closedAt   DateTime?

  // Relations
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
  parent   Task?  @relation("StoryChildren", fields: [parentId], references: [id])
  children Task[] @relation("StoryChildren")
  assignee   User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter   User  @relation("TaskReporter", fields: [reporterId], references: [id])
  comments      Comment[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  taskId    Int
  authorId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //relations:
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
}

model AuditLog {
  id        Int          @id @default(autoincrement())
  taskId    Int
  userId    Int
  type      ActivityType
  oldValue  String?
  newValue  String?
  createdAt DateTime     @default(now())

  //relations:
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  taskId    Int?
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  //relations:
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// enums:
enum GlobalRole {
  GLOBAL_ADMIN
  USER
}

enum ProjectRole {
  PROJECT_ADMIN
  PROJECT_MEMBER
  PROJECT_VIEWER
}

enum IssueType {
  STORY
  TASK
  BUG
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActivityType {
  STATUS_CHANGE
  ASSIGNEE_CHANGE
  PRIORITY_CHANGE
  COMMENT_ADDED
  COMMENT_EDITED
  COMMENT_DELETED
  TASK_CREATED
}

enum NotificationType {
  TASK_ASSIGNED
  STATUS_CHANGED
  COMMENT_ADDED
  USER_MENTIONED
}
